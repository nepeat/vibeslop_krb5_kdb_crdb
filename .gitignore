# secrets — never commit any of these
/.env
/ansible/secrets/
/k8s/.crdb-certs/
/k8s/.admin-pass
/k8s/.master-pass
/k8s/.registry-pass
/k8s/.registry-htpasswd
/k8s/.bootstrap/
/e2e/.certs/
/e2e/.state/

# terraform state carries IPs/resource ids; providers are re-fetched by init
/terraform/aws/.terraform/
*.tfstate
*.tfstate.backup

# generated by terraform (live host IPs)
/ansible/inventory/aws/

# leftover rootfs from the retired image-build/ dir — the image is now
# `nix build .#kdc-image`; safe to delete the local copy
/image-build/

# build & run artifacts
/target
/ansible/.cache/
/e2e/qps.log
