# Makefile for the kurbu5 Rust workspace
#
# This file covers the Cargo build and test targets for the Kerberos KDB
# Rust plugin framework.  When integrated into the upstream krb5 build system
# (iteration 9 of the work plan) this file would become a Makefile.in
# generated by autoconf, with the following changes:
#
#   - CARGO, KRB5_INCLUDE_DIR, KRB5_LIB_DIR substituted by configure
#   - A top-level --enable-rust-kdb configure flag guards the build
#   - The check targets are invoked from the krb5 top-level make check
#
# For now it is a standalone Makefile usable directly with `make`.

# ---------------------------------------------------------------------------
# Configurable variables (override on the command line or via environment)
# ---------------------------------------------------------------------------

CARGO           ?= cargo
# Optional: override the krb5 include directory found by pkg-config.
KRB5_INCLUDE_DIR ?=
# Optional: override the krb5 library directory found by pkg-config.
KRB5_LIB_DIR    ?=

# Cargo build profile: release or debug.
CARGO_PROFILE   ?= release

# Extra flags forwarded to every cargo invocation.
CARGO_FLAGS     ?=

# ---------------------------------------------------------------------------
# Internal variables
# ---------------------------------------------------------------------------

ifeq ($(CARGO_PROFILE),release)
  PROFILE_FLAG := --release
else
  PROFILE_FLAG :=
endif

# Build environment: propagate optional path overrides to build.rs.
BUILD_ENV :=
ifneq ($(KRB5_INCLUDE_DIR),)
  BUILD_ENV += KRB5_INCLUDE_DIR=$(KRB5_INCLUDE_DIR)
endif
ifneq ($(KRB5_LIB_DIR),)
  BUILD_ENV += KRB5_LIB_DIR=$(KRB5_LIB_DIR)
endif

CARGO_CMD := $(BUILD_ENV) $(CARGO)

# ---------------------------------------------------------------------------
# Targets
# ---------------------------------------------------------------------------

.PHONY: all build check clean fmt clippy test

all: build

## build — compile the workspace (default: --release)
build:
	$(CARGO_CMD) build --workspace $(PROFILE_FLAG) $(CARGO_FLAGS)

## check — run the full acceptance test suite (mirrors standing criteria)
check: fmt clippy test

## fmt — verify formatting (zero diffs required)
fmt:
	$(CARGO_CMD) fmt --check --all $(CARGO_FLAGS)

## clippy — lint with warnings-as-errors
clippy:
	$(CARGO_CMD) clippy --workspace $(CARGO_FLAGS) -- -D warnings

## test — run all unit and integration tests
test:
	$(CARGO_CMD) test --workspace $(CARGO_FLAGS)

## clean — remove Cargo build artefacts
clean:
	$(CARGO_CMD) clean

# ---------------------------------------------------------------------------
# Help
# ---------------------------------------------------------------------------

help:
	@echo "Targets:"
	@echo "  all / build   Compile the workspace (CARGO_PROFILE=release by default)"
	@echo "  check         Run fmt + clippy + test (standing acceptance criteria)"
	@echo "  fmt           Check formatting with cargo fmt --check"
	@echo "  clippy        Lint with cargo clippy -D warnings"
	@echo "  test          Run cargo test --workspace"
	@echo "  clean         Remove Cargo build artefacts"
	@echo ""
	@echo "Variables:"
	@echo "  CARGO            Path to the cargo binary (default: cargo)"
	@echo "  CARGO_PROFILE    release (default) or debug"
	@echo "  KRB5_INCLUDE_DIR Override krb5 include directory (otherwise pkg-config)"
	@echo "  KRB5_LIB_DIR     Override krb5 library directory (otherwise pkg-config)"
	@echo "  CARGO_FLAGS      Extra flags forwarded to every cargo invocation"
